# Backend Environment Variables Configuration
# PharmaConnect - Third-Party Integration Security Policy Compliant
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit this file with real values to version control
# 2. Use environment-specific .env files (.env.production, .env.staging)
# 3. Rotate secrets regularly per company policy
# 4. Only expose NEXT_PUBLIC_* variables from frontend - backend secrets stay server-only
# 5. All secrets must be validated before application startup

# ==================== APPLICATION CONFIGURATION ====================

NODE_ENV=development
PORT=5000
JWT_SECRET=your_super_secret_jwt_secret_key_here_min_32_chars_required
JWT_EXPIRES_IN=24h

# CORS - Set to your frontend origin in production
# POLICY: A. Secure Configuration
CORS_ORIGIN=http://localhost:3000

# ==================== DATABASE CONFIGURATION ====================
# POLICY: B. Secrets Management - All credentials via environment

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=pharmaconnect
DATABASE_PASSWORD=secure_database_password_here
DATABASE_NAME=pharmaconnect_db

# ==================== ZOOM INTEGRATION ====================
# POLICY: A. Secure Configuration - All Zoom communication uses HTTPS
# POLICY: B. Secrets Management - API credentials server-side only
# 
# Get these from: https://marketplace.zoom.us/
# 1. Create "Server-to-Server OAuth" application
# 2. Copy Account ID, Client ID, and Client Secret
# 3. Set required scopes: meeting:write, meeting:read, user:read

ZOOM_ACCOUNT_ID=your_zoom_account_id_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here_keep_secure
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret_for_signature_verification

# ==================== OPENAI INTEGRATION ====================
# POLICY: A. Secure Configuration - API key server-side only
# POLICY: E. AI Safety Guard - Prompt injection prevention enabled
#
# Get API key from: https://platform.openai.com/api-keys
# IMPORTANT: 
# - This is a critical secret, rotate regularly
# - Use Enterprise API tier for HIPAA compliance
# - Disable data retention for model training
# - Monitor usage for cost control

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_TIMEOUT_MS=30000

# ==================== GOOGLE OAUTH INTEGRATION ====================
# POLICY: B. Secrets Management - Credentials server-side
#
# Get credentials from: https://console.cloud.google.com/
# 1. Create OAuth 2.0 Web Application credentials
# 2. Add redirect URI: http://localhost:5000/auth/google/callback
#
# Scopes used: email, profile (no personal data beyond identification)

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# ==================== JITSI MEET INTEGRATION (LEGACY) ====================
# POLICY: A. Secure Configuration - AppID externalized, no hardcoding
#
# If using Jitsi, provide configuration here:
# JITSI_SERVER_URL=https://meet.jit.si
# JITSI_APP_ID=your_jitsi_app_id_if_applicable

# ==================== LOGGING & MONITORING ====================

LOG_LEVEL=debug
DEBUG=pharmaconnect:*

# ==================== SECURITY SETTINGS ====================

# Session configuration
SESSION_SECRET=your_session_secret_min_32_chars_minimum_required
SESSION_TIMEOUT_MS=3600000

# Rate limiting (webhooks)
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=100

# ==================== SECURITY POLICY COMPLIANCE ====================
#
# This configuration implements:
# ✓ A. Secure Configuration (HTTPS, env vars, error sanitization)
# ✓ B. Secrets Management (no hardcoding, server-side only, validation)
# ✓ C. Webhook Security (signature verification, timeouts, rate limiting)
# ✓ D. Safe Links/Redirects (URL validation, no sensitive data in URLs)
# ✓ E. Third-Party Risk Assessment (vendor compliance verified)
#
# For compliance verification, see: THIRD_PARTY_SECURITY_ASSESSMENTS.md
# For policy details, see: IS4660_Third_Party_Integration_Security_Policy.md

# ==================== PRODUCTION CHECKLIST ====================
# Before deploying to production, ensure:
#
# [ ] All secrets are unique and strong (min 32 characters)
# [ ] CORS_ORIGIN is set to production domain
# [ ] NODE_ENV=production
# [ ] All credentials are rotated from development
# [ ] Zoom webhook secret is configured
# [ ] OpenAI API key is in Enterprise tier
# [ ] Google OAuth callback URL matches production domain
# [ ] Database credentials are production-grade
# [ ] Session secrets are rotated
# [ ] Logging is configured for audit trails
# [ ] Rate limiting is appropriate for production load
# [ ] Secrets are stored in secure vault (AWS Secrets Manager, etc.)
# [ ] No secrets in git history (verify with: git log --name-only --diff-filter=D)
# [ ] All third-party services are in production configuration
# [ ] Security incidents response procedure is documented
# [ ] Incident notification contacts are configured
